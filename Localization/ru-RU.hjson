			InfinityPouch: {
				DisplayName: Бесконечный подсумок
				Tooltip: Расходует пустоту вместо боеприпасов
			}

			ChallengerRing: {
				DisplayName: Кольцо претендента
				Tooltip:
					'''
					Нажмите ПКМ, когда предмет находится в избранном, чтобы инвертировать выбранный самоцвет, отключая его основной эффект и активируя противоположный
					0
					1
					2
					3
					4
					5
					6
					'''
				G0: Связывает блоки при добыче, позволяя сломать до 50 блоков за раз
				G1: Убийство врагов дарует случайный бафф на 30 секунд
				G2: Создаёт монеты при получении пустоты
				G3: Из враги с 14.3% шансом выпадает вдвое больше добычи
				G4:
					'''
					Убитые враги имеют 50% шанс оставить дополнительные сердца (100% при критическом ударе)
					Сбор сердец продлевает действие активных баффов (вплоть до двойной длительности)
					'''
				G5:
					'''
					Увеличивает урон в зависимости от защиты, затем снижает защиту на треть от полученного бонуса к урону
					Увеличивает урон на {0}%
					Снижает защиту на {1}
					'''
				G6: Получение урона дарует случайный бафф на 30 секунд
				# Opposite of Sloth, Diligence
				I0:
					'''
					Увеличивает скорость размещения блоков и стен на 20%, а дистанцию установки — на 3
					Увеличивает скорость передвижения на 20%
					'''
				# Opposite of Wrath, Patience
				I1: Вы получаете случайный бафф на 30 секунд каждые 20 секунд
				# Opposite of Greed, Charity
				I2:
					'''
					При получении урона 10% от него преобразуется в пустоту
					При использовании пустоты 10% затрат преобразуется в здоровье
					'''
				# Opposite of Envy, Kindness
				I3:
					'''
					Снижает получаемый урон на 15%
					Снижает наносимый урон на 15%
					'''
				# Opposite of Gluttony, Temperance
				I4:
					'''
					Даёт постоянный эффект «{$BuffName.WellFed}»
					Пустотные расходники восстанавливают на 75% меньше пустоты
					'''
				# Opposite of Pride, Humility
				I5:
					'''
					Вы больше не можете наносить критические удары
					Бонусы к шансу критического удара преобразуются в мультипликативное увеличение урона
					'''
				# Opposite of Lust, Chastity
				I6:
					'''
					Баффы не истекают, пока ваше здоровье выше 90%
					При получении урона, если здоровье ниже 90%, длительность всех баффов сокращается вдвое
					'''
			}

			EarthGrinder: {
