		Configuration: {
			Header: {
				UI: Интерфейс
				GS: Графика
				TPS: Текстурпак
				GPS: Геймплей
				BAL: Баланс
				MS: Музыка
			}

			Label: {
				Config: Конфигурация
				SConfig: Серверная конфигурация
				VBX: Позиция шкалы пустоты по X
				VBY: Позиция шкалы пустоты по Y
				LVB: Закрепить шкалу пустоты
				AVBD: Альтернативное направление шкалы пустоты
				AVBS: Альтернативный стиль шкалы пустоты
				VBTT: Текст над шкалой пустоты
				VBHT: Всплывающий текст шкалы пустоты
				SVBT: Упрощённый текст шкалы пустоты
				SVBF: Упрощённое наполнение шкалы пустоты
				PM: Режим производительности
				CTF: Цветная заморозка времени
				AVE: Дополнительные визуальные эффекты
				SHT: Тип стартового дома при генерации мира
				NINS: Ослабить Парящую инсигнию до Люкс
				BLZD: Альтернативная музыка SOTS
			}

			Tooltip: {
				VBX:
					'''
					Горизонтальное положение шкалы пустоты на экране
					Отсчитывается в пикселях от левого края
					'''
				VBY:
					'''
					Вертикальное положение шкалы пустоты на экране
					Отсчитывается в пикселях от верхнего края
					'''
				LVB:
					'''
					Запрещает перемещать шкалу пустоты курсором
					Также предотвращает автоматическую изменение позиции при использовании стиля интерфейса «Шкала»
					'''
				AVBD: Изменяет направление, в котором шкала пустоты «свёртывается» при заполнении
				AVBS: Немного изменяет внешний вид шкалы пустоты
				VBTT: Включить или выключить отображение текста над шкалой пустоты
				VBHT: Включить или выключить текст, появляющийся при наведении курсора на шкалу пустоты
				SVBT: Убирает индикаторы количества активных пустотных миньонов из текста на шкале
				SVBF: Убирает полоски между внутренними сегментами шкалы пустоты
				PM:
					'''
					Отключает часть визуальных эффектов для повышения частоты кадров (FPS)
					В основном влияет на эффекты боссов и послеобразы от снарядов
					'''
				CTF: Определяет, будет ли цвет экрана во время заморозки времени оттенённым или чёрно-белым
				AVE:
					'''
					Добавляет дополнительные визуальные эффекты, например, частицы пыли, для некоторых блоков
					Работает только при включённом текстурпаке SOTS.
					'''
				SHT:
					'''
					-2 = Без стартового дома (вы безумны)
					-1 = Случайный стартовый дом
					0 = Наследие: Дом
					1 = Наследие: Ангел
					2 = Наследие: Бочка
					3 = Наследие: БОЛЬШОЙ отель
					4 = Наследие: Исток
					5 = Наследие: Башня
					6 = Наследие: Меч
					7 = Наследие: Дерево
					8 = Наследие: Библиотека
					9 = Наследие: Ящик
					10 = Mushnib'а
					11 = Astrobit'а
					12 = Кровавая луна
					13 = Бандит
					14 = Валун
					15 = Шахта
					16 = Таверна
					17 = Хаос
					18 = Затопленный дом
					19 = Уютный дом
					20 = Природный дом
					'''
				NINS:
					'''
					Ослабляет Парящую инсигнию, даруя бесконечный полёт только после победы над Люкс.
					До этого она будет лишь удваивать время полёта.
					Если вы не согласны с этим изменением, отключите эту опцию.
					'''
				BLZD:
					'''
					Если включено, в допустимых местах будет играть саундтрек от Banana Lizard.
					Если выключено, в допустимых местах будет играть саундтрек от Heart Plus Up.
					'''
			}
		}

