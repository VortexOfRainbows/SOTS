					Окружает вас 4 орбитальными снарядами (отключаются, если аксессуар скрыт)
					Отбрасывает атакующих врагов от вас с помощью метательных копий
					'''
			}

			CrestofDasuver: {
				DisplayName: Эмблема Дасувера
				Tooltip: Увеличивает шанс критического удара на 6%
			}

			DigitalDaito: {
				DisplayName: Цифровое дайто
				Tooltip: ""
			}

			Doomstick: {
				DisplayName: Дум-стек
				Tooltip:
					'''
					Выпускает два выстрела из дробовика подряд
					Нажмите ПКМ, чтобы выпустить крюк (250% урона), притягивающий врагов
					Вместо этого притягивает вас к боссам
					Убитые враги оставляют наборы здоровья и маны
					'''
			}

			ElectromagneticDeterrent: {
				DisplayName: Излучатель помех электромагнитного поля
				Tooltip: Предотвращает появление конструктов, пока предмет в руках, в избранном или размещён в мире
			}

			ElectromagneticLure: {
				DisplayName: Электромагнитная приманка
				Tooltip: Призывает одного биомного конструкта
				PossibleConstructs: "Доступные конструкты: "
				None: Нет
			}

			ExplosiveKnife: {
				DisplayName: Взрывной нож
				Tooltip: «Весьма смертоносное сочетание»
			}

			FlashsparkBoots: {
				DisplayName: Сапоги искромётной вспышки
				Tooltip:
					'''
					Обеспечивают колоссальное ускорение при беге
					Позволяют летать и дают дополнительную мобильность на льду
					Значительно увеличивают скорость передвижения
					Позволяют ходить по воде и лаве
					Даруют иммунитет к огненным блокам и 10 секунд иммунитета к лаве
					При беге вы совершаете неконтролируемый рывок вперёд с огромной скоростью
					«Recipro Burst!»
					'''
			}

			FortressGenerator: {
				DisplayName: Генератор крепости
				Tooltip:
					'''
					Увеличивает максимальное количество миньонов и стражей на 1
					Увеличивает урон на 10% и регенерацию здоровья на 2
					Создаёт по 4 платформы слева и справа от вас
					Нажмите ПКМ, чтобы переместить их; платформы всегда симметричны
					На них можно устанавливать турели
					Поглощает 25% урона союзников, если ваше здоровье выше 25%, и даёт иммунитет к отбрасыванию
					'''
			}

			HealPack: {
				DisplayName: Лечебный набор
				Tooltip: ""
			}

			ManaPack: {
				DisplayName: Компресс маны
				Tooltip: ""
			}

			HelicopterParts: {
				DisplayName: Детали вертолёта
				Tooltip: ""
			}

			MinersSword: {
				DisplayName: Меч шахтёра
				Tooltip: Наносит критический удар при атаке в падении
			}

			OlympianAegis: {
				DisplayName: Олимпийская эгида
				Tooltip:
					'''
					Увеличивает получаемое количество пустоты на 2 и регенерацию здоровья на 1
					Снижает получаемый урон на 7% и увеличивает шанс крита на 4%
					'''
			}

			OlympianAxe: {
				DisplayName: Олимпийский боевой топор
				Tooltip:
					'''
					Входит в состояние исступления на 3 сек. после убийства врага, 
					сильно увеличивая скорость атаки ближнего боя
					Нажмите ПКМ, чтобы метнуть топор (60% урона)
					В состоянии исступления можно метнуть два топора
					'''
			}

			PeanutButter: {
				DisplayName: Арахисовое масло
				Tooltip:
					'''
					Призывает питомца-Гнилостного Пинки для помощи в бою
					Цепляется за врагов, замедляя их и выкачивая жизнь
					Увеличивает регенерацию здоровья на 1
					'''
			}

			RoyalJelly: {
				DisplayName: Королевское желе
				Tooltip:
					'''
					Увеличивает количество здоровья, получаемого от зелий, на 40 ед.
					«Я мог бы прямо сейчас отпустить одну очень, очень плохую шутку...»
					'''
			}

			Sandwich: {
				DisplayName: Сэндвич
				Tooltip:
					'''
					Увеличивает количество здоровья, получаемого от зелий, на 40 ед.
					При убийстве врагов выпадают крошки багета
					Призывает питомца-Гнилостного Пинки для помощи в бою
					Он цепляется за врагов, замедляя их и выкачивая жизнь
					Увеличивает регенерацию здоровья на 1
					'''
			}

			SpectreSpiritStorm: {
				DisplayName: Спектральный шторм
				Tooltip: Выпускает 3 фантомные стрелы, каждая из которых мгновенно поражает до 4 целей за раз
			}

			SubspaceBoosters: {
				DisplayName: Подпространственные ускорители
				Tooltip:
					'''
					Обеспечивают колоссальное ускорение при беге
					Позволяют летать и дают дополнительную мобильность на льду
					Значительно увеличивают скорость передвижения
					Позволяют ходить по воде и лаве
					Даруют иммунитет к огненным блокам и 10 секунд иммунитета к лаве
					Дважды нажмите кнопку рывка на земле, чтобы совершить стремительный выпад вперёд
					'''
			}

			ZombieHand: {
				DisplayName: Рука зомби
				Tooltip:
					'''
					Позволяет атакам ближнего боя наносить урон городским жителям
