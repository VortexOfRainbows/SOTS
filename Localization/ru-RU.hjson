		Items: {
			AncientSteelBar: {
				# Abandoned Village
				DisplayName: Слиток древней стали
				# Abandoned Village
				Tooltip: «Древний прототип стали, использовавшийся различными цивилизациями... и гоблинами»
			}

			AncientSteelHalberd: {
				DisplayName: Алебарда из древней стали
				Tooltip:
					'''
					Раскалывает врагов, заставляя следующую атаку ближнего боя гарантированно нанести критический удар, игнорирующий защиту
					Сама алебарда не может воспользоваться эффектом раскола
					'''
			}

			AncientSteelLongbow: {
				DisplayName: Длинный лук из древней стали
				Tooltip:
					'''
					Требуется время, чтобы натянуть тетиву перед выстрелом
					Стрелы летят быстро и взрываются на пронзающие осколки, нанося 100% урона при попадании во врагов
					'''
			}

			AncientSteelSword: {
				DisplayName: Меч из древней стали
				Tooltip:
					'''
					При попадании наносит 80% урона по области
					Критические удары наносят на 50% больше урона и могут наложить накопительное, постоянное проклятие кровотечения, наносящее по 5 ед. урона в секунду
					'''
			}

